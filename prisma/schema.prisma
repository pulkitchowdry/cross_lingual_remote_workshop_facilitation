// Run `prisma migrate dev` after installing Prisma and setting DATABASE_URL.
// The application code must keep database access server-only.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  DRAFT
  LIVE
  ENDED
}

enum ParticipantRole {
  FACILITATOR
  LEARNER
  CO_FACILITATOR
  OBSERVER
}

enum InsightType {
  ACTIVITY
  DECISION
  BLOCKER
  CONFUSION
}

/**
 * AUTO: try local-inference first, fall back to cloud providers on failure. LOCAL_ONLY: never call cloud providers, even on local failure — see docs/TRANSLATION_ARCHITECTURE.md Part 5.
 */
enum TranslationMode {
  AUTO
  LOCAL_ONLY
}

model User {
  id                String               @id @default(cuid())
  displayName       String
  preferredLanguage String?
  createdAt         DateTime             @default(now())
  sessions          Session[]            @relation("SessionFacilitator")
  participations    SessionParticipant[]
  sentMessages      Message[]            @relation("MessageSender")
  receivedMessages  Message[]            @relation("MessageRecipient")
}

model Session {
  id                 String               @id @default(cuid())
  title              String
  goal               String
  sourceLanguage     String
  learnerLanguages   String[]
  // Float, not Int — SetupForm offers sub-day presets (5 minutes, 1 hour) so a
  // facilitator can actually demo/verify the cleanup cron's automatic-deletion
  // behavior without waiting a full day; see setup/actions.ts's validation.
  retentionDays      Float                @default(7)
  translationMode    TranslationMode      @default(AUTO)
  status             SessionStatus        @default(DRAFT)
  // Whether the server-side caption agent (caption-agent.ts) is currently streaming this
  // session's facilitator audio. Must live in the database, not in-process memory: the
  // LiveKit Agents worker that sets this runs in a forked OS process (see server.ts /
  // @livekit/agents' per-job JobProcExecutor), a different process from the one serving
  // the facilitator dashboard that reads it — an in-memory flag set in one and read from
  // the other is silently always false.
  captionAgentActive Boolean              @default(false)
  // Generated once, fire-and-forget, when endSession() runs (see facilitator/actions.ts
  // and insights.ts's generateAndPersistSessionSummary) — null until that background call
  // finishes, at which point a poll picks it up (matches generateSessionInsights' own
  // fire-and-forget pattern; this app runs a persistent process, not a Vercel Function, so
  // a plain unawaited call outlives the request with no `waitUntil` needed). Nullable, not
  // a required field with an empty-string default: distinguishes "not generated yet /
  // insights not configured" from "generated, and genuinely came back empty".
  summary            String?              @db.Text
  facilitatorId      String
  facilitator        User                 @relation("SessionFacilitator", fields: [facilitatorId], references: [id])
  createdAt          DateTime             @default(now())
  startedAt          DateTime?
  endedAt            DateTime?
  participants       SessionParticipant[]
  joinLinks          JoinLink[]
  transcript         TranscriptSegment[]
  messages           Message[]
  insights           Insight[]
  glossaryTerms      GlossaryTerm[]
  glossarySuggestions GlossarySuggestion[]
  whiteboard         WhiteboardSnapshot?
  translations       SessionTranslation[]
}

/**
 * Per-language translations of a session's facilitator-authored `title`/`goal`,
 * populated once at createSession() time (mirrors MessageTranslation's "translate
 * into every SUPPORTED_LANGUAGES entry up front" pattern, not TranscriptSegment's
 * per-utterance one — a session's title/goal are set once and read many times, so
 * there's no live translation step to repeat). `title`/`goal` are nullable, not a
 * required pair: the two fields are translated independently (two separate
 * translateText calls), so a transient failure on one must not discard the other.
 * No row exists at all for the session's own sourceLanguage (translateText returns
 * null for a same-language pair, same as MessageTranslation) — the facilitator's own
 * views always render the raw Session.title/goal columns directly.
 */
model SessionTranslation {
  id             String  @id @default(cuid())
  sessionId      String
  targetLanguage String
  title          String?
  goal           String?
  provider       String
  session        Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, targetLanguage])
}

model SessionParticipant {
  id                String          @id @default(cuid())
  sessionId         String
  userId            String
  role              ParticipantRole
  preferredLanguage String
  consentedAt       DateTime?
  joinedAt          DateTime        @default(now())
  lastActiveAt      DateTime        @default(now())
  /**
   * SHA-256 hash of the random opaque secret issued to a learner at join time
   * and stored in their session cookie (see session-security.ts hashToken /
   * createOpaqueToken). The learner's ongoing session credential must be this
   * secret, never `id` itself — `id` is also this participant's LiveKit room
   * identity (see room.ts), which every other participant in the room can
   * read, so using it as the session credential too would let any co-learner
   * impersonate any other by copying that publicly-visible id into their own
   * cookie.
   */
  accessTokenHash   String?         @unique
  session           Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model JoinLink {
  id        String          @id @default(cuid())
  sessionId String
  role      ParticipantRole @default(LEARNER)
  tokenHash String          @unique
  expiresAt DateTime?
  revokedAt DateTime?
  maxUses   Int?
  useCount  Int             @default(0)
  createdAt DateTime        @default(now())
  session   Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model TranscriptSegment {
  id           String            @id @default(cuid())
  sessionId    String
  speakerId    String?
  originalText String
  language     String
  startedAt    DateTime
  endedAt      DateTime
  isFinal      Boolean           @default(true)
  /// True for the facilitator's typed-caption composer, false for anything transcribed from live audio.
  isTyped      Boolean           @default(false)
  /// 0-100 speech-recognition confidence reported by the STT tier (Deepgram), null for typed captions
  /// and tiers that don't report one (local-inference, mock) — see src/lib/confidence.ts.
  sttConfidence Int?
  /// 0-100 network/connection-quality signal derived from the speaker's live LiveKit
  /// connectionQuality at capture time (see confidence.ts's estimateNetworkConfidence),
  /// null for typed captions and any live capture with no quality report yet.
  networkQuality Int?
  createdAt    DateTime          @default(now())
  session      Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  translations Translation[]
  evidence     InsightEvidence[]
}

model Translation {
  id                  String            @id @default(cuid())
  transcriptSegmentId String
  targetLanguage      String
  text                String
  provider            String
  qualitySignal       String?
  /// 0-100 overall Confidence Score for this translation — see src/lib/confidence.ts.
  confidence          Int?
  confidenceLevel     String?
  /// The signal identified as most responsible for a Medium/Low confidenceLevel, if any — one of
  /// "audio" | "translation" | "network".
  rootCause           String?
  /// 0-100 translation-signal breakdown feeding `confidence` above — see
  /// src/lib/confidence.ts's ConfidenceSignals. audioQuality/network aren't stored per
  /// translation: audioQuality has no real measurement source at all yet (always the
  /// same default), and network is a property of the segment's own capture, not any one
  /// translation of it — see TranscriptSegment.networkQuality.
  translationConfidence Int?
  preservedSpans      Json?
  transcriptSegment   TranscriptSegment @relation(fields: [transcriptSegmentId], references: [id], onDelete: Cascade)

  @@unique([transcriptSegmentId, targetLanguage])
}

model GlossaryTerm {
  id                  String   @id @default(cuid())
  sessionId           String
  sourceTerm          String
  approvedTranslation String?
  aliases             String[]
  preserveVerbatim    Boolean  @default(false)
  session             Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sourceTerm])
}

/**
 * The shared, cross-session "Centralised Technical Glossary" (issue #131) —
 * unlike GlossaryTerm above (one session's ad-hoc approved translations),
 * rows here are visible to and editable by every facilitator, and are looked
 * up before translation for ANY session regardless of who created the entry.
 * `translations` maps a target language code (matches Session.learnerLanguages/
 * SUPPORTED_LANGUAGES, e.g. "zh"/"es") to the preferred rendering; a language
 * missing from the map falls back to `sourceTerm` verbatim, which is exactly
 * what `translate: false` entries want (e.g. product names like "LiveKit").
 */
model CentralGlossaryEntry {
  id           String   @id @default(cuid())
  sourceTerm   String   @unique
  category     String?
  notes        String?
  /// false = always keep sourceTerm verbatim in every target language, ignoring `translations`.
  translate    Boolean  @default(true)
  translations Json
  /// Ships with the app (seeded by migration), vs. added by a facilitator — surfaced in the
  /// glossary page so built-ins read as defaults rather than something a facilitator typed in.
  isBuiltIn    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum GlossarySuggestionStatus {
  PENDING
  APPROVED
  IGNORED
}

/**
 * A technical term detected in a session's transcript that has no
 * CentralGlossaryEntry yet (issue #131's "Record unknown technical terms" +
 * "Recommend new glossary entries in the post-meeting summary"). Accumulates
 * occurrenceCount across a session rather than one row per mention, so the
 * post-meeting recommendation list can be ranked by how often a term came up.
 */
model GlossarySuggestion {
  id              String                   @id @default(cuid())
  sessionId       String
  sourceTerm      String
  occurrenceCount Int                      @default(1)
  lastSeenAt      DateTime                 @default(now())
  status          GlossarySuggestionStatus @default(PENDING)
  createdAt       DateTime                 @default(now())
  session         Session                  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sourceTerm])
}

/**
 * One row per session — a debounced full-scene snapshot of the live whiteboard
 * (Excalidraw's elements array, including each text element's `customData`
 * translation payload) for late-joiners and page reloads. Not the live-sync
 * path — that's a LiveKit DataChannel topic ("whiteboard"), see room.ts.
 */
model WhiteboardSnapshot {
  id        String   @id @default(cuid())
  sessionId String   @unique
  elements  Json
  updatedAt DateTime @updatedAt
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Message {
  id           String               @id @default(cuid())
  sessionId    String
  senderId     String
  recipientId  String?
  originalText String
  language     String
  kind         String
  isAnonymous  Boolean              @default(false)
  sentAt       DateTime             @default(now())
  session      Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender       User                 @relation("MessageSender", fields: [senderId], references: [id])
  recipient    User?                @relation("MessageRecipient", fields: [recipientId], references: [id])
  translations MessageTranslation[]

  @@index([sessionId, recipientId])
  @@index([sessionId, senderId])
}

model MessageTranslation {
  id             String  @id @default(cuid())
  messageId      String
  targetLanguage String
  text           String
  provider       String
  qualitySignal  String?
  message        Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, targetLanguage])
}

model Insight {
  id        String            @id @default(cuid())
  sessionId String
  type      InsightType
  summary   String
  status    String            @default("ACTIVE")
  createdAt DateTime          @default(now())
  session   Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evidence  InsightEvidence[]
}

model InsightEvidence {
  insightId           String
  transcriptSegmentId String
  insight             Insight           @relation(fields: [insightId], references: [id], onDelete: Cascade)
  transcriptSegment   TranscriptSegment @relation(fields: [transcriptSegmentId], references: [id], onDelete: Cascade)

  @@id([insightId, transcriptSegmentId])
}
