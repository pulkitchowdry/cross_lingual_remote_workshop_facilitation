# Copy this file to .env.local for local development (or to .env if you're
# using Docker Compose — see docker-compose.yml's top comment for why one
# file covers both). PostgreSQL is required before database-backed sessions
# can be enabled.
# Local development (native `npm run dev`, connecting to a Postgres running
# directly on your machine — Docker Compose's bundled Postgres is separate,
# see POSTGRES_* below):
DATABASE_URL="postgresql://workshop:workshop@localhost:5432/workshop_copilot"
# Production/staging: point this at a Railway PostgreSQL connection string
# instead (Railway dashboard -> Postgres service -> "Connect" -> copy the
# external connection URL, or `${{Postgres.DATABASE_URL}}` for Railway
# service-to-service refs). See docs/AUTH_DATABASE_ARCHITECTURE.md for the
# auth + database hosting decision (#53).
# DATABASE_URL="postgresql://postgres:<password>@<host>.railway.app:<port>/railway"

# Docker Compose only (docker-compose.yml's `postgres` service) — the
# containerized `web` service builds its own DATABASE_URL from these, always
# pointing at the Compose-internal `postgres:5432` regardless of
# POSTGRES_PORT (see the comment on that service's `ports:` for why).
# POSTGRES_PORT only matters for reaching the container from your host (e.g.
# `psql`, or a native `npm run dev` pointed at Compose's Postgres instead of
# its own) — change it here in your own gitignored .env if 5432 is already
# taken by another Postgres on your machine (keep .env.example itself on the
# conventional 5432, since it's the shared template, not a personal
# workaround):
POSTGRES_USER="workshop"
POSTGRES_PASSWORD="workshop"
POSTGRES_DB="workshop_copilot"
POSTGRES_PORT="5432"

# Clerk (facilitator authentication — see docs/AUTH_DATABASE_ARCHITECTURE.md).
# Get keys at https://dashboard.clerk.com. Learner join links are unaffected
# — they stay on the existing cookie/token flow in session-access.ts.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Add provider settings only as the corresponding live feature is implemented.
# LiveKit Cloud example: wss://your-project.livekit.cloud
# Following are variables for local testing (livekit-server --dev's default port is 7880)
LIVEKIT_URL="http://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
# STT_API_KEY=""
# ElevenLabs API key, used for opt-in translated-audio playback.
# Get one at https://elevenlabs.io/app/settings/api-keys
TTS_API_KEY=""
# Only needed when LIVEKIT_URL above isn't reachable from inside this app's
# own process/container (e.g. Docker Compose, where LIVEKIT_URL is a
# host-reachable address for the browser but the in-process caption agent
# worker — src/lib/caption-agent.ts, server-side LiveKit track subscription,
# see docs/TRANSLATION_ARCHITECTURE.md Part 2 — needs the internal one).
# LIVEKIT_AGENT_URL="http://livekit:7880"
# Self-hosted local-inference service (NLLB translation / faster-whisper STT /
# Piper TTS) — see local-inference/README.md. Tried first for every
# translation/caption/voice request before falling back to the cloud
# providers below, unless a session's strict-privacy mode disables that
# fallback. CLAUDE_API_KEY/STT_API_KEY/TTS_API_KEY below remain the cloud
# fallback-tier credentials, not the only providers.
# Local development: run `docker build -t clrwf-local-inference local-inference`
# then `docker run -p 8080:8080 -e LOCAL_INFERENCE_SECRET=devsecret clrwf-local-inference`
LOCAL_INFERENCE_URL="http://localhost:8080"
LOCAL_INFERENCE_SECRET="devsecret"
# Production/staging: point this at your deployed local-inference Railway
# service instead, and set LOCAL_INFERENCE_SECRET to a real random string
# matching what you configured on that Railway service.

# Claude (Anthropic) API key, used for live caption translation (cloud
# fallback tier — see LOCAL_INFERENCE_URL above for the local-first default).
# Get one at https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=""
CLAUDE_API_URL="https://api.anthropic.com/v1/messages"
# INSIGHT_MODEL_API_KEY=""
# Authorizes Vercel Cron's calls to /api/retention/cleanup, which enforces
# each session's retentionDays by deleting expired sessions (see vercel.json
# and docs/FEATURE_LIST.md Module 6 "Automatic deletion after session").
# Vercel sends `Authorization: Bearer <CRON_SECRET>` automatically once this
# is set as a project environment variable — generate any random string.
CRON_SECRET=""

# Public base URL this app is actually reachable at — used to build the
# learner invite link and its QR code (facilitator page). Silently falls back
# to http://localhost:3000 if unset, so this MUST be set to your real Railway
# domain (or custom domain) in any non-local deployment, or every invite
# link/QR you hand a learner points at localhost and can't be reached.
# NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"

# Development-only caption latency logs for manual audio/translation testing.
# Ignored in production and never logs audio bytes or caption text.
# CAPTION_LATENCY_LOGS="1"
