# Copy this file to .env.local for local development. PostgreSQL is required
# before database-backed sessions can be enabled.
#
# Local development:
DATABASE_URL="postgresql://workshop:workshop@localhost:5432/workshop_copilot"
# Production/staging: point this at a Railway PostgreSQL connection string
# instead (Railway dashboard -> Postgres service -> "Connect" -> copy the
# external connection URL, or `${{Postgres.DATABASE_URL}}` for Railway
# service-to-service refs). See docs/AUTH_DATABASE_ARCHITECTURE.md for the
# auth + database hosting decision (#53).
# DATABASE_URL="postgresql://postgres:<password>@<host>.railway.app:<port>/railway"

# Clerk (facilitator authentication — see docs/AUTH_DATABASE_ARCHITECTURE.md).
# Get keys at https://dashboard.clerk.com. Learner join links are unaffected
# — they stay on the existing cookie/token flow in session-access.ts.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY=""

# Add provider settings only as the corresponding live feature is implemented.
# LiveKit Cloud example: wss://your-project.livekit.cloud
# Following are variables for local testing
LIVEKIT_URL="http://localhost:7882"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
# STT_API_KEY=""
# ElevenLabs API key, used for opt-in translated-audio playback.
# Get one at https://elevenlabs.io/app/settings/api-keys
# TTS_API_KEY=""
# Shared secret + this app's public base URL, used by the standalone
# agent/ worker (server-side LiveKit track subscription — see
# docs/TRANSLATION_ARCHITECTURE.md Part 2). Only needed if you run that worker.
# CAPTION_AGENT_SECRET=""
# APP_BASE_URL="http://localhost:3000"
# Claude (Anthropic) API key, used for live caption translation.
# Get one at https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=""
CLAUDE_API_URL="https://api.anthropic.com/v1/messages"
# INSIGHT_MODEL_API_KEY=""
