# Copy this file to .env.local for local development. PostgreSQL is required
# before database-backed sessions can be enabled.
DATABASE_URL="postgresql://workshop:workshop@localhost:5432/workshop_copilot"

# Add provider settings only as the corresponding live feature is implemented.
# LiveKit Cloud example: wss://your-project.livekit.cloud
# Following are variables for local testing
LIVEKIT_URL="http://localhost:7882"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
